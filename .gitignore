# Repo-wide ignores. vision/ keeps its own .gitignore for folder-specific
# rules; these apply everywhere, including the root.

# Python
__pycache__/
*.py[oc]
.venv/

# Tracker run output (track-combined --json-log / --json-out). Run output, not
# source: a session is ~10 MB per ten minutes. test.jsonl is the one committed
# sample recording.
runs/
*.jsonl
!vision/test.jsonl
*.json.tmp
state.json
live_state.json

# OS / editor noise
.DS_Store
Thumbs.db

# Simulator and strategy (moved here from robocup/.gitignore)
archive/godot/.godot/
addons/godot-git-plugin/
# RL training output: only the one committed checkpoint is kept
strategy/rl/checkpoints/*
!strategy/rl/checkpoints/first_final/
strategy/rl/checkpoints/first_final/*
!strategy/rl/checkpoints/first_final/final.zip
strategy/rl/tb_logs/
strategy/rl/runs/

# Web app: npm installs, never committed
app/web/node_modules/
