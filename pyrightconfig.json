{
  "include": ["sim", "strategy", "vision", "app/server", "robot"],
  "exclude": [".venv", "**/__pycache__", "**/node_modules", "archive"],
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",

  "executionEnvironments": [
    { "root": "sim", "extraPaths": [".", "sim"] },
    { "root": "strategy", "extraPaths": [".", "sim"] },
    { "root": "vision" },
    { "root": "app/server", "extraPaths": ["sim", "robot"] },
    // MicroPython on the XRP: machine, bluetooth, XRPLib and time.ticks_ms
    // only exist there
    { "root": "robot/firmware", "extraPaths": ["robot/firmware", "robot/firmware/lib"],
      "reportMissingImports": "none", "reportAttributeAccessIssue": "none" },
    { "root": "robot", "extraPaths": ["robot"] }
  ],

  "reportUnknownVariableType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownParameterType": "none",
  "reportUnknownLambdaType": "none",
  "reportMissingTypeStubs": "none",

  "reportAny": "none",
  "reportExplicitAny": "none",
  "reportMissingParameterType": "none"
}
